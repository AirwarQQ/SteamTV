<!-- The Home page banner: an original night scene — dusk sky with drifting clouds, a moon, the
     city, a TV glowing in a window, and a sakura branch. Two layers share the same 680×236
     coordinates: the scene, then the fades that keep the text readable, then the petals on top,
     so they float across the whole banner. All motion lives in NightScene.xaml.cs and only runs
     while the banner is on screen. -->
<UserControl x:Class="SteamTV.Controls.NightScene"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="True" IsHitTestVisible="False">
    <Grid>
        <Viewbox Stretch="UniformToFill" VerticalAlignment="Top">
            <Canvas Width="680" Height="236" ClipToBounds="True">
                <Rectangle Width="680" Height="236">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1A1840" Offset="0" />
                            <GradientStop Color="#3B2C6E" Offset="0.55" />
                            <GradientStop Color="#8A4C8F" Offset="0.85" />
                            <GradientStop Color="#E28AA9" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Stars (twinkle) and a shooting star now and then -->
                <Canvas x:Name="Stars">
                    <Ellipse Canvas.Left="299" Canvas.Top="29" Width="2" Height="2" Fill="White" Opacity="0.8" />
                    <Ellipse Canvas.Left="358.8" Canvas.Top="56.8" Width="2.4" Height="2.4" Fill="White" Opacity="0.8" />
                    <Ellipse Canvas.Left="429.1" Canvas.Top="21.1" Width="1.8" Height="1.8" Fill="White" Opacity="0.8" />
                    <Ellipse Canvas.Left="498.9" Canvas.Top="46.9" Width="2.2" Height="2.2" Fill="White" Opacity="0.8" />
                    <Ellipse Canvas.Left="609" Canvas.Top="25" Width="2" Height="2" Fill="White" Opacity="0.8" />
                    <Ellipse Canvas.Left="649.2" Canvas.Top="69.2" Width="1.6" Height="1.6" Fill="White" Opacity="0.8" />
                    <Ellipse Canvas.Left="389.2" Canvas.Top="95.2" Width="1.6" Height="1.6" Fill="White" Opacity="0.8" />
                    <Ellipse Canvas.Left="559" Canvas.Top="87" Width="2" Height="2" Fill="White" Opacity="0.8" />
                    <Ellipse Canvas.Left="331" Canvas.Top="80" Width="1.6" Height="1.6" Fill="White" Opacity="0.7" />
                    <Ellipse Canvas.Left="463" Canvas.Top="58" Width="1.4" Height="1.4" Fill="White" Opacity="0.7" />
                    <Ellipse Canvas.Left="250" Canvas.Top="40" Width="1.6" Height="1.6" Fill="White" Opacity="0.6" />
                    <Ellipse Canvas.Left="200" Canvas.Top="18" Width="1.8" Height="1.8" Fill="White" Opacity="0.6" />
                </Canvas>
                <Line x:Name="ShootingStar" X1="0" Y1="0" X2="34" Y2="10" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Canvas.Left="300" Canvas.Top="20" Opacity="0">
                    <Line.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#FFFFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Line.Stroke>
                    <Line.RenderTransform><TranslateTransform x:Name="ShootingMove" /></Line.RenderTransform>
                </Line>

                <!-- Clouds, drifting slowly to the right; filled in code -->
                <Canvas x:Name="Clouds" />

                <!-- Moon: floats a little, its halo breathes -->
                <Canvas x:Name="Moon">
                    <Canvas.RenderTransform><TranslateTransform x:Name="MoonDrift" /></Canvas.RenderTransform>
                    <Ellipse x:Name="MoonGlow" Canvas.Left="500" Canvas.Top="2" Width="120" Height="120" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="MoonGlowScale" /></Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#8CFFF3F8" Offset="0" />
                                <GradientStop Color="#00FFF3F8" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Left="534" Canvas.Top="36" Width="52" Height="52" Fill="#FFF1F6" />
                    <Ellipse Canvas.Left="549" Canvas.Top="33" Width="44" Height="44" Fill="#3B2C6E" Opacity="0.18" />
                </Canvas>

                <!-- City -->
                <Canvas>
                    <Rectangle Canvas.Left="300" Canvas.Top="150" Width="34" Height="86" Fill="#2A2150" />
                    <Rectangle Canvas.Left="338" Canvas.Top="128" Width="26" Height="108" Fill="#2A2150" />
                    <Rectangle Canvas.Left="368" Canvas.Top="160" Width="40" Height="76" Fill="#2A2150" />
                    <Rectangle Canvas.Left="412" Canvas.Top="118" Width="22" Height="118" Fill="#2A2150" />
                    <Rectangle Canvas.Left="438" Canvas.Top="146" Width="36" Height="90" Fill="#2A2150" />
                    <Rectangle Canvas.Left="478" Canvas.Top="134" Width="28" Height="102" Fill="#2A2150" />
                    <Rectangle Canvas.Left="510" Canvas.Top="164" Width="44" Height="72" Fill="#2A2150" />
                    <Rectangle Canvas.Left="558" Canvas.Top="124" Width="24" Height="112" Fill="#2A2150" />
                    <Rectangle Canvas.Left="586" Canvas.Top="152" Width="38" Height="84" Fill="#2A2150" />
                    <Rectangle Canvas.Left="628" Canvas.Top="140" Width="52" Height="96" Fill="#2A2150" />
                </Canvas>
                <Canvas x:Name="Windows" Opacity="0.75">
                    <Rectangle Canvas.Left="344" Canvas.Top="140" Width="4" Height="5" Fill="#FFD9A8" />
                    <Rectangle Canvas.Left="354" Canvas.Top="152" Width="4" Height="5" Fill="#FFD9A8" />
                    <Rectangle Canvas.Left="418" Canvas.Top="132" Width="4" Height="5" Fill="#FFD9A8" />
                    <Rectangle Canvas.Left="418" Canvas.Top="160" Width="4" Height="5" Fill="#FFD9A8" />
                    <Rectangle Canvas.Left="486" Canvas.Top="148" Width="4" Height="5" Fill="#FFD9A8" />
                    <Rectangle Canvas.Left="564" Canvas.Top="138" Width="4" Height="5" Fill="#FFD9A8" />
                    <Rectangle Canvas.Left="572" Canvas.Top="170" Width="4" Height="5" Fill="#FFD9A8" />
                    <Rectangle Canvas.Left="640" Canvas.Top="156" Width="4" Height="5" Fill="#FFD9A8" />
                    <Rectangle Canvas.Left="596" Canvas.Top="166" Width="4" Height="5" Fill="#FFD9A8" />
                    <Rectangle Canvas.Left="306" Canvas.Top="164" Width="4" Height="5" Fill="#FFD9A8" />
                </Canvas>

                <!-- TV in a window, its glow breathes -->
                <Ellipse x:Name="TvGlow" Canvas.Left="350" Canvas.Top="172" Width="240" Height="80">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#8C7FD6FF" Offset="0" />
                            <GradientStop Color="#007FD6FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Canvas Canvas.Left="408" Canvas.Top="170">
                    <Rectangle Width="124" Height="70" RadiusX="6" RadiusY="6" Fill="#12152A" Stroke="#B37FD6FF" StrokeThickness="1" />
                    <Rectangle Canvas.Left="6" Canvas.Top="6" Width="112" Height="58" RadiusX="3" RadiusY="3" Fill="#1F3A5C" />
                    <Path Data="M42,22 L68,35 L42,48 Z" Fill="#7FD6FF" Opacity="0.9" />
                </Canvas>

                <!-- Sakura branch, swaying from where it enters the frame (top right); blossoms added in code -->
                <Canvas x:Name="Branch">
                    <Canvas.RenderTransform>
                        <RotateTransform x:Name="BranchSway" CenterX="690" CenterY="4" />
                    </Canvas.RenderTransform>
                    <!-- Bark: the main limb tapers from the corner in three strokes, then thin twigs. -->
                    <Path Stroke="#24152C" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M704,-4 C684,6 664,16 638,32" />
                    <Path Stroke="#24152C" StrokeThickness="5.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M638,32 C618,44 602,56 588,70" />
                    <Path Stroke="#24152C" StrokeThickness="3.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M588,70 C576,82 566,92 556,106" />
                    <Path Stroke="#24152C" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M664,17 C672,28 676,38 678,50 M640,31 C644,46 646,58 652,72 M612,50 C614,40 618,32 626,24 M596,63 C586,60 578,58 568,60" />
                    <!-- A faint highlight along the top of the limb -->
                    <Path Stroke="#3D2747" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.8"
                          Data="M700,-6 C682,4 662,14 637,29 C618,41 603,52 590,66" />
                    <Canvas x:Name="Blossoms" />
                </Canvas>
            </Canvas>
        </Viewbox>

        <!-- Fades under the text -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#EB0F1222" Offset="0" />
                    <GradientStop Color="#8C0F1222" Offset="0.42" />
                    <GradientStop Color="#000F1222" Offset="0.72" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                    <GradientStop Color="#FF0F1222" Offset="0" />
                    <GradientStop Color="#000F1222" Offset="0.4" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Petals, above the fades so they float across the whole banner -->
        <Viewbox Stretch="UniformToFill" VerticalAlignment="Top">
            <Canvas Width="680" Height="236" ClipToBounds="True">
                <Canvas x:Name="Petals" />
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
