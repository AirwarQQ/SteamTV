<ui:FluentWindow x:Class="SteamTV.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="SteamTV Monitor"
                 Width="520" Height="760"
                 ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 Closing="OnClosing"
                 StateChanged="OnStateChanged">

    <ui:FluentWindow.Resources>
        <!-- Card doesn't stretch its content by default, which lets Auto/star columns
             inside it measure against infinite width and overflow past the window edge. -->
        <Style TargetType="ui:Card">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: FluentWindow has no native chrome, so this is what makes the
             window draggable and provides minimize/close — plus the theme switcher. -->
        <ui:TitleBar Grid.Row="0" ShowMaximize="False" CanMaximize="False"
                     Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnThemeLight" Content="Light" Padding="10,4" FontSize="11" Margin="0,0,4,0"
                               ToolTip="Light theme" Click="BtnThemeLight_Click" />
                    <ui:Button x:Name="BtnThemeDark" Content="Dark" Padding="10,4" FontSize="11" Margin="0,0,4,0"
                               ToolTip="Dark theme" Click="BtnThemeDark_Click" />
                    <ui:Button x:Name="BtnThemeSystem" Content="Auto" Padding="10,4" FontSize="11"
                               ToolTip="Follow system theme" Click="BtnThemeSystem_Click" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tabs -->
        <TabControl Grid.Row="0" Height="440" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

            <!-- Monitor tab -->
            <TabItem Header="Monitor">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,12,0,0">

                    <!-- Connection -->
                    <TextBlock Text="Connection" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TV IP:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" x:Name="TxtIp" />
                            </Grid>
                            <TextBlock x:Name="LblAdb" Text="○ ADB  ↺15s" Margin="0,6,0,0"
                                       FontWeight="Bold" Foreground="Gray"
                                       ToolTip="ADB reachability check — runs in background every 15 s.&#x0a;green = reachable   orange = not reachable" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="HDMI port:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ui:NumberBox Grid.Column="1" x:Name="NumHdmiPort" Width="110" Minimum="1" Maximum="4"
                                              SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" />
                            </Grid>
                            <TextBlock Text="1–4, used by the TV External Source app" Margin="0,6,0,0"
                                       Foreground="Gray" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Display -->
                    <TextBlock Text="Display" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Target display #:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ui:NumberBox Grid.Column="1" x:Name="NumTarget" Width="110" Minimum="1" Maximum="64"
                                              SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" />
                            </Grid>
                            <Button x:Name="BtnDisplays" Content="Displays…" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" Click="BtnDisplays_Click" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Features -->
                    <TextBlock Text="Features" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <ui:Card>
                        <StackPanel>
                            <CheckBox x:Name="ChkDisableOthers" Content="Disable other monitors when TV is active" Margin="0,0,0,8" />
                            <CheckBox x:Name="ChkWakeTV" Content="Wake TV via ADB on gamepad connect" Margin="0,0,0,8" />
                            <CheckBox x:Name="ChkSourceSwitch" Content="Switch HDMI source on TV" Margin="0,0,0,8" />
                            <CheckBox x:Name="ChkBigPicture" Content="Launch Steam Big Picture" Margin="0,0,0,8" />
                            <CheckBox x:Name="ChkAutostart" Content="Run at Windows startup (hidden in tray)"
                                      Checked="ChkAutostart_CheckedChanged" Unchecked="ChkAutostart_CheckedChanged" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Gamepads tab -->
            <TabItem Header="Gamepads">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,12,0,0">

                    <TextBlock Text="Watched — trigger SteamTV when any of these connects"
                               FontWeight="SemiBold" Margin="2,0,0,6" TextWrapping="Wrap" />
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ListBox Grid.Column="0" x:Name="LstWatched" Height="150" />
                                <Button Grid.Column="1" x:Name="BtnRemove" Content="Remove" Margin="8,0,0,0"
                                        VerticalAlignment="Top" Click="BtnRemove_Click" />
                            </Grid>
                            <TextBlock x:Name="LblNoGamepads"
                                       Text="⚠  No gamepads configured — add at least one to enable the trigger."
                                       Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </ui:Card>

                    <TextBlock Text="Connected right now" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <ui:Card>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ListBox Grid.Column="0" x:Name="LstConnected" Height="130" />
                                <Button Grid.Column="1" x:Name="BtnRefresh" Content="Refresh" Margin="8,0,0,0"
                                        VerticalAlignment="Top" Click="BtnRefresh_Click" />
                            </Grid>
                            <Button x:Name="BtnAdd" Content="↑ Add to Watched" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" Click="BtnAdd_Click" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Test tab -->
            <TabItem Header="Test">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Test individual actions" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <ui:Card>
                        <UniformGrid x:Name="TestButtonsPanel" Columns="2" />
                    </ui:Card>
                    <TextBlock Margin="2,10,0,0" Foreground="Gray" TextWrapping="Wrap"
                               Text="Each action runs in the background and logs the result below. Settings are saved before each test." />
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Advanced tab -->
            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,12,0,0">

                    <TextBlock Text="Paths" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="adb.exe path" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtAdbPath" />
                            <TextBlock Text="Blank / just &quot;adb.exe&quot; uses whatever is on your PATH." Margin="0,4,0,0"
                                       Foreground="Gray" TextWrapping="Wrap" />

                            <TextBlock Text="steam.exe path" Margin="0,14,0,4" />
                            <TextBox x:Name="TxtSteamPath" />
                        </StackPanel>
                    </ui:Card>

                    <TextBlock Text="TV integration (only if your TV isn't Xiaomi/MiTV)" FontWeight="SemiBold"
                               Margin="2,0,0,6" TextWrapping="Wrap" />
                    <ui:Card>
                        <StackPanel>
                            <TextBlock Text="HDMI activity pattern" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtHdmiActivityPattern" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                                       Text="Regex matched against 'adb shell dumpsys activity activities' to confirm the TV's HDMI-source screen actually opened. The default only matches the Xiaomi/MiTV player — on another TV, source-switch detection will always time out until you set this to whatever activity your TV's launcher shows." />

                            <TextBlock Text="TV home component" Margin="0,14,0,4" />
                            <TextBox x:Name="TxtTvHomeComponent" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                                       Text="Android component (package/.Activity) launched via 'adb shell am start -n ...' to send the TV back to its home screen when Big Picture closes. The default targets the ProjengMenu launcher — set it to your TV's own launcher component if different." />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status -->
        <TextBlock Grid.Row="1" x:Name="LblStatus" Margin="0,12,0,10" FontWeight="Bold" FontSize="13" />

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button x:Name="BtnStart" Content="Start" Width="100" Appearance="Primary" Click="BtnStart_Click" />
            <Button x:Name="BtnStop" Content="Stop" Width="100" Margin="8,0,0,0" Click="BtnStop_Click" />
            <Button x:Name="BtnExit" Content="Exit" Width="110" Margin="150,0,0,0" Click="BtnExit_Click" />
        </StackPanel>

        <!-- Log -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Log:" Margin="0,0,0,6" />
            <TextBox Grid.Row="1" x:Name="TxtLog" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" />
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
