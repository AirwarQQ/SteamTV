<ui:FluentWindow x:Class="SteamTV.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="SteamTV Monitor"
                 Width="600" Height="930"
                 ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 Closing="OnClosing"
                 StateChanged="OnStateChanged">

    <ui:FluentWindow.Resources>
        <!-- Card doesn't stretch its content by default, which lets Auto/star columns
             inside it measure against infinite width and overflow past the window edge. -->
        <Style TargetType="ui:Card">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!-- Read-only so text cells never enter edit mode; the CheckBox template stays clickable. -->
        <Style x:Key="DeviceGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <!-- Star column already fits the width; a selected row's few px of indent would otherwise
                 summon a horizontal scrollbar that eats a row's worth of height. -->
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: FluentWindow has no native chrome, so this is what makes the
             window draggable and provides minimize/close — plus the theme switcher. -->
        <ui:TitleBar Grid.Row="0" ShowMaximize="False" CanMaximize="False"
                     Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}">
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                    <ui:Button x:Name="BtnThemeLight" Content="Light" Padding="10,4" FontSize="11" Margin="0,0,4,0"
                               ToolTip="Light theme" Click="BtnThemeLight_Click" />
                    <ui:Button x:Name="BtnThemeDark" Content="Dark" Padding="10,4" FontSize="11" Margin="0,0,4,0"
                               ToolTip="Dark theme" Click="BtnThemeDark_Click" />
                    <ui:Button x:Name="BtnThemeSystem" Content="Auto" Padding="10,4" FontSize="11"
                               ToolTip="Follow system theme" Click="BtnThemeSystem_Click" />
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Tabs -->
        <TabControl Grid.Row="0" Height="610" x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

            <!-- Monitor tab -->
            <TabItem Header="Monitor">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,12,0,0">

                    <!-- Connection -->
                    <TextBlock Text="Connection" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="TV IP:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" x:Name="TxtIp" />
                            </Grid>
                            <TextBlock x:Name="LblAdb" Text="○ ADB  ↺15s" Margin="0,6,0,0"
                                       FontWeight="Bold" Foreground="Gray"
                                       ToolTip="ADB reachability check — runs in background every 15 s.&#x0a;green = reachable   orange = not reachable" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="HDMI port:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ui:NumberBox Grid.Column="1" x:Name="NumHdmiPort" Width="110" Minimum="1" Maximum="4"
                                              SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" />
                            </Grid>
                            <TextBlock Text="1–4, used by the TV External Source app" Margin="0,6,0,0"
                                       Foreground="Gray" TextWrapping="Wrap" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Display -->
                    <TextBlock Text="Display" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Target display #:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ui:NumberBox Grid.Column="1" x:Name="NumTarget" Width="110" Minimum="1" Maximum="64"
                                              SpinButtonPlacementMode="Inline" ClearButtonEnabled="False" />
                            </Grid>
                            <Button x:Name="BtnDisplays" Content="Displays…" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" Click="BtnDisplays_Click" />
                        </StackPanel>
                    </ui:Card>

                    <!-- Features -->
                    <TextBlock Text="Features" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <ui:Card>
                        <StackPanel>
                            <CheckBox x:Name="ChkDisableOthers" Content="Disable other monitors when TV is active" Margin="0,0,0,8" />
                            <CheckBox x:Name="ChkWakeTV" Content="Wake TV via ADB when a device connects" Margin="0,0,0,8" />
                            <CheckBox x:Name="ChkSourceSwitch" Content="Switch HDMI source on TV" Margin="0,0,0,8" />
                            <CheckBox x:Name="ChkBigPicture" Content="Launch Steam Big Picture" Margin="0,0,0,8" />
                            <CheckBox x:Name="ChkAutostart" Content="Run at Windows startup (hidden in tray)"
                                      Checked="ChkAutostart_CheckedChanged" Unchecked="ChkAutostart_CheckedChanged" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Devices tab -->
            <TabItem Header="Devices">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,12,0,0">

                    <TextBlock Text="Trigger devices — activate the TV when a ticked one connects"
                               FontWeight="SemiBold" Margin="2,0,0,6" TextWrapping="Wrap" />
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Header (~35) + 4 rows of WPF-UI's 36 — room for a few trigger devices without scrolling. -->
                            <DataGrid x:Name="GridWatched" Height="184" Style="{StaticResource DeviceGrid}"
                                      SelectionChanged="GridWatched_SelectionChanged">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                                        <Setter Property="ToolTip" Value="{Binding Detail}" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="On" Width="44" SortMemberPath="Enabled">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                          MinWidth="0" Padding="0"
                                                          HorizontalAlignment="Center"
                                                          ToolTip="Only ticked devices trigger the TV" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}"
                                                        SortMemberPath="CategoryRank" Width="140" />
                                    <DataGridTemplateColumn Header="Status" SortMemberPath="IsConnected" Width="108">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- Nothing selected: hint (+ warning when nothing is ticked). -->
                            <StackPanel x:Name="PnlNoSelection" Margin="0,8,0,0">
                                <TextBlock x:Name="LblNoDevices" Margin="0,0,0,4"
                                           Text="⚠  No ticked devices — add one from the list below."
                                           Foreground="OrangeRed" TextWrapping="Wrap" />
                                <TextBlock Foreground="Gray" TextWrapping="Wrap"
                                           Text="Select a device above to rename it or choose what it does." />
                            </StackPanel>

                            <!-- Settings of the selected trigger device. -->
                            <Grid x:Name="PnlDevice" Margin="0,8,0,0" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtAlias" ClearButtonEnabled="False"
                                            ToolTip="Your own name for this device — leave empty to use the product name"
                                            LostKeyboardFocus="TxtAlias_LostKeyboardFocus" KeyDown="TxtAlias_KeyDown" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="On connect:" VerticalAlignment="Center" Margin="12,0,8,0" />
                                <ComboBox Grid.Row="0" Grid.Column="3" x:Name="CmbAction" Width="168"
                                          SelectionChanged="CmbAction_SelectionChanged">
                                    <ComboBoxItem Content="TV + Big Picture"
                                                  ToolTip="Full sequence: wake TV, switch displays and HDMI input, launch Big Picture" />
                                    <ComboBoxItem Content="TV only"
                                                  ToolTip="Wake TV and switch displays/HDMI input, but don't launch Big Picture" />
                                </ComboBox>
                                <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" x:Name="ChkRestoreOnDisconnect"
                                          Margin="0,8,0,0" Checked="ChkRestoreOnDisconnect_Changed" Unchecked="ChkRestoreOnDisconnect_Changed"
                                          Content="Restore monitors when it disconnects (after 10 s)"
                                          ToolTip="Once this device has been gone for 10 seconds: close Big Picture, restore the monitor layout and send the TV home. Handy with 'TV only', which has no Big Picture to close." />
                                <Button Grid.Row="1" Grid.Column="3" x:Name="BtnRemove" Content="Remove" Margin="0,8,0,0"
                                        HorizontalAlignment="Right" Click="BtnRemove_Click" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <Grid Margin="2,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Devices on this PC" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" x:Name="CmbCategory" MinWidth="170"
                                  SelectionChanged="CmbCategory_SelectionChanged" />
                    </Grid>
                    <ui:Card>
                        <StackPanel>
                            <DataGrid x:Name="GridConnected" Height="170" Style="{StaticResource DeviceGrid}"
                                      MouseDoubleClick="GridConnected_MouseDoubleClick">
                                <DataGrid.RowStyle>
                                    <!-- Must extend WPF-UI's row style, not the stock one, or rows render white in dark mode. -->
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                                        <Setter Property="ToolTip" Value="{Binding Detail}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWatched}" Value="True">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}"
                                                        SortMemberPath="CategoryRank" Width="140" />
                                    <DataGridTextColumn Header="Bus" Binding="{Binding Bus}" Width="86" />
                                    <DataGridTemplateColumn Header="Status" SortMemberPath="IsConnected" Width="108">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}"
                                                           VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="Gray" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="Updates live. Click a header to sort; double-click a row to add it." />
                                <Button Grid.Column="1" x:Name="BtnAdd" Content="↑ Add" Margin="8,0,0,0"
                                        Click="BtnAdd_Click" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Test tab -->
            <TabItem Header="Test">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Test individual actions" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <ui:Card>
                        <UniformGrid x:Name="TestButtonsPanel" Columns="2" />
                    </ui:Card>
                    <TextBlock Margin="2,10,0,0" Foreground="Gray" TextWrapping="Wrap"
                               Text="Each action runs in the background and logs the result below. Settings are saved before each test." />
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Advanced tab -->
            <TabItem Header="Advanced">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,12,0,0">

                    <TextBlock Text="Paths" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <ui:Card Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="adb.exe path" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtAdbPath" />
                            <TextBlock Text="Blank / just &quot;adb.exe&quot; uses whatever is on your PATH." Margin="0,4,0,0"
                                       Foreground="Gray" TextWrapping="Wrap" />

                            <TextBlock Text="steam.exe path" Margin="0,14,0,4" />
                            <TextBox x:Name="TxtSteamPath" />
                        </StackPanel>
                    </ui:Card>

                    <TextBlock Text="TV integration" FontWeight="SemiBold"
                               Margin="2,0,0,6" TextWrapping="Wrap" />
                    <ui:Card>
                        <StackPanel>
                            <TextBlock Text="HDMI activity pattern" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtHdmiActivityPattern" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                                       Text="Regex matched against 'adb shell dumpsys activity activities' to confirm the TV's HDMI-source screen actually opened. The default matches Xiaomi/MiTV's player — on another TV, switch to the PC's HDMI input by hand, then run that command over adb and look for the line containing 'ResumedActivity'; the package/.Activity shown there is what to put here (escape any dots with backslashes)." />

                            <TextBlock Text="TV home component" Margin="0,14,0,4" />
                            <TextBox x:Name="TxtTvHomeComponent" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                                       Text="Android component (package/.Activity) launched via 'adb shell am start -n ...' to send the TV back to its home screen when Big Picture closes. The default targets the ProjengMenu launcher — to find yours, go back to the TV's home screen by hand, then run 'adb shell dumpsys activity activities' again and copy the package/.Activity from the 'ResumedActivity' line." />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status -->
        <TextBlock Grid.Row="1" x:Name="LblStatus" Margin="0,12,0,10" FontWeight="Bold" FontSize="13" />

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <ui:Button x:Name="BtnStart" Content="Start" Width="100" Appearance="Primary" Click="BtnStart_Click" />
            <Button x:Name="BtnStop" Content="Stop" Width="100" Margin="8,0,0,0" Click="BtnStop_Click" />
            <Button x:Name="BtnExit" Content="Exit" Width="110" Margin="150,0,0,0" Click="BtnExit_Click" />
        </StackPanel>

        <!-- Manual override — force TV on/off regardless of gamepad/Big Picture state -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <ui:Button x:Name="BtnActivateNow" Content="Activate now" Width="150" Appearance="Secondary"
                       ToolTip="Manually run the full activation sequence (wake TV, switch HDMI, launch Big Picture) without waiting for a gamepad."
                       Click="BtnActivateNow_Click" />
            <Button x:Name="BtnDeactivateNow" Content="Deactivate / Restore" Width="150" Margin="8,0,0,0"
                    ToolTip="Manually restore monitors and send the TV back to its home screen — also works as a recovery button if state gets out of sync."
                    Click="BtnDeactivateNow_Click" />
        </StackPanel>

        <!-- Log -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Log:" Margin="0,0,0,6" />
            <TextBox Grid.Row="1" x:Name="TxtLog" IsReadOnly="True" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="12" />
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
