<ui:FluentWindow x:Class="SteamTV.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:l="clr-namespace:SteamTV"
                 xmlns:c="clr-namespace:SteamTV.Controls"
                 Title="SteamTV"
                 Icon="pack://application:,,,/start_icon.ico"
                 Width="940" Height="700" MinWidth="820" MinHeight="600"
                 Background="{StaticResource BgBrush}"
                 FontFamily="{StaticResource BodyFont}"
                 WindowStartupLocation="CenterScreen"
                 Closing="OnClosing"
                 StateChanged="OnStateChanged">

    <ui:FluentWindow.Resources>
        <!-- Read-only so text cells never enter edit mode; the CheckBox template stays clickable. -->
        <Style x:Key="DeviceGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- Star column already fits the width; a selected row's few px of indent would otherwise
                 summon a horizontal scrollbar that eats a row's worth of height. -->
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{StaticResource BgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource DeepBrush}" />
        <ui:TitleBar Grid.Row="0" Grid.ColumnSpan="2" ShowMaximize="True" Title="" Height="36" />
        <!-- App mark in the title bar; not hit-testable, so the bar still drags the window. -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border Width="15" Height="15" CornerRadius="4" Background="{StaticResource SakuraDiagonal}" Margin="0,0,10,0" />
            <TextBlock Text="SteamTV" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
        </StackPanel>

        <!-- ============================== Sidebar ============================== -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource DeepBrush}" BorderBrush="#151832" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,4,10,12">
                <TextBlock DockPanel.Dock="Top" Margin="10,6,0,18" FontFamily="{StaticResource DisplayFont}" FontWeight="ExtraBold" FontSize="21">
                    <Run Text="Steam" Foreground="{StaticResource TextBrush}" /><Run Text="TV" Foreground="{StaticResource SakuraGradient}" />
                </TextBlock>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="BtnNavSupport" Style="{StaticResource QuietButton}" Margin="0,0,0,12" Padding="12,8" HorizontalContentAlignment="Left"
                            Click="Support_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Heart24" FontSize="16" Foreground="{StaticResource SakuraBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="{l:Tr Nav.Support}" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <Border BorderBrush="#151832" BorderThickness="0,1,0,0" Padding="12,10,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="NavLed" Width="7" Height="7" Fill="{StaticResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Ellipse.Effect><DropShadowEffect x:Name="NavLedGlow" Color="#7EE8C4" BlurRadius="8" ShadowDepth="0" Opacity="0" /></Ellipse.Effect>
                                </Ellipse>
                                <TextBlock x:Name="LblNavStatus" FontSize="12" Foreground="{StaticResource SoftBrush}" />
                            </StackPanel>
                            <TextBlock x:Name="LblNavVersion" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox x:Name="NavList" SelectionChanged="NavList_SelectionChanged" BorderThickness="0" Background="Transparent"
                         ItemContainerStyle="{StaticResource NavItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBoxItem><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Home24" FontSize="18" Margin="0,0,12,0" /><TextBlock Text="{l:Tr Nav.Home}" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Games24" FontSize="18" Margin="0,0,12,0" /><TextBlock Text="{l:Tr Nav.Devices}" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,12,0" /><TextBlock Text="{l:Tr Nav.Settings}" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Building24" FontSize="18" Margin="0,0,12,0" /><TextBlock Text="{l:Tr Nav.HomeAssistant}" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                    <ListBoxItem><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Wrench24" FontSize="18" Margin="0,0,12,0" /><TextBlock Text="{l:Tr Nav.Diagnostics}" VerticalAlignment="Center" /></StackPanel></ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Pages: one visible at a time, picked by the sidebar (see ShowPage). -->
        <Grid Grid.Row="1" Grid.Column="1" x:Name="Pages">

            <!-- ============================== Home ============================== -->
            <Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Height="250">
                        <c:NightScene x:Name="Scene" />
                        <StackPanel Margin="28,26,0,0" MaxWidth="390" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <TextBlock x:Name="LblKana" Style="{StaticResource Kana}" />
                            <StackPanel x:Name="HeroCopy" MinHeight="78">
                                <TextBlock x:Name="LblHeroTitle" FontFamily="{StaticResource DisplayFont}" FontWeight="ExtraBold" FontSize="30"
                                           Margin="0,4,0,6" TextWrapping="Wrap" />
                                <TextBlock x:Name="LblHeroText" FontSize="13" Foreground="{StaticResource SoftBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="StatusPill" Margin="0,14,0,0" HorizontalAlignment="Left" CornerRadius="14" Padding="11,5,13,5" MinHeight="28"
                                    Background="#1A7FD6FF" BorderBrush="#477FD6FF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusLed" Width="7" Height="7" Fill="{StaticResource SkyBrush}" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse.Effect><DropShadowEffect x:Name="StatusGlow" Color="#7FD6FF" BlurRadius="8" ShadowDepth="0" Opacity="0.9" /></Ellipse.Effect>
                                    </Ellipse>
                                    <TextBlock x:Name="LblStatus" FontSize="12" FontWeight="Medium" Foreground="{StaticResource SkyBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="24,0,24,22">
                        <StackPanel Orientation="Horizontal" Margin="0,-4,0,0">
                            <Button x:Name="BtnActivateNow" Style="{StaticResource PlayButton}" Click="BtnActivateNow_Click" >
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M0,0 L11,7 L0,14 Z" Fill="White" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:Tr Home.Play}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnDeactivateNow" Style="{StaticResource QuietButton}" Margin="10,0,0,0" Click="BtnDeactivateNow_Click"
                                    Content="{l:Tr Home.Back}"  />
                            <Button x:Name="BtnHomeSetup" Style="{StaticResource PlayButton}" Margin="10,0,0,0" Click="AutoSetup_Click"
                                    Content="{l:Tr Home.Setup}" Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock x:Name="LblHomeSetup" Style="{StaticResource Hint}" Margin="2,10,0,0" Visibility="Collapsed" />

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <DockPanel>
                                        <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Pulse24" Style="{StaticResource TileIcon}" /></Border>
                                        <ToggleButton x:Name="TglMonitoring" DockPanel.Dock="Right" Style="{StaticResource Toggle}"
                                                      Checked="TglMonitoring_Changed" Unchecked="TglMonitoring_Changed" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{l:Tr Home.Monitoring}" Style="{StaticResource CardTitle}" />
                                            <TextBlock Text="{l:Tr Home.Monitoring.Sub}" Style="{StaticResource Hint}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <Border Style="{StaticResource IconTile}" TextElement.Foreground="{StaticResource SakuraBrush}"><ui:SymbolIcon Symbol="Games24" Style="{StaticResource TileIcon}" /></Border>
                                        <Border x:Name="ChipTrigger" DockPanel.Dock="Right" Style="{StaticResource Chip}" Cursor="Hand" MouseLeftButtonUp="GoDevices_Click">
                                            <TextBlock x:Name="LblTriggerChip" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="LblTriggerName" Style="{StaticResource CardTitle}" />
                                            <TextBlock x:Name="LblTriggerSub" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <Border Style="{StaticResource IconTile}" TextElement.Foreground="{StaticResource SkyBrush}"><ui:SymbolIcon Symbol="Tv24" Style="{StaticResource TileIcon}" /></Border>
                                        <Border x:Name="ChipTv" DockPanel.Dock="Right" Style="{StaticResource Chip}">
                                            <TextBlock x:Name="LblTvChip" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock x:Name="LblTvName" Style="{StaticResource CardTitle}" />
                                            <TextBlock x:Name="LblTvSub" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <TextBlock Text="{l:Tr Home.Recent}" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                    <TextBlock x:Name="LblRecent" FontFamily="Consolas" FontSize="12" LineHeight="21" Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================== Devices ============================== -->
            <Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,20">
                    <TextBlock Text="デ バ イ ス" Style="{StaticResource Kana}" />
                    <TextBlock Text="{l:Tr Nav.Devices}" Style="{StaticResource PageTitle}" />

                    <TextBlock Text="{l:Tr Dev.Triggers}" Style="{StaticResource Section}" Margin="2,10,0,2" />
                    <TextBlock Text="{l:Tr Dev.Triggers.Sub}" Style="{StaticResource Hint}" Margin="2,0,0,8" />
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <StackPanel>
                            <!-- Header (~35) + 4 rows of WPF-UI's 36 — room for a few trigger devices without scrolling. -->
                            <DataGrid x:Name="GridWatched" Height="184" Style="{StaticResource DeviceGrid}"
                                      SelectionChanged="GridWatched_SelectionChanged">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                                        <Setter Property="ToolTip" Value="{Binding Detail}" />
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{l:Tr Dev.Col.On}" Width="50" SortMemberPath="Enabled">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                                          MinWidth="0" Padding="0" HorizontalAlignment="Center"
                                                          ToolTip="{l:Tr Dev.OnTip}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{l:Tr Dev.Col.Device}" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="{l:Tr Dev.Col.Category}" Binding="{Binding CategoryText}" SortMemberPath="CategoryRank" Width="176" />
                                    <DataGridTemplateColumn Header="{l:Tr Dev.Col.Status}" SortMemberPath="IsConnected" Width="124">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <!-- Nothing selected: hint (+ warning when nothing is ticked). -->
                            <StackPanel x:Name="PnlNoSelection" Margin="4,8,0,0">
                                <TextBlock x:Name="LblNoDevices" Margin="0,0,0,4" Text="{l:Tr Dev.NoneTicked}" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:Tr Dev.SelectHint}" />
                            </StackPanel>
                            <!-- Settings of the selected trigger device. -->
                            <Grid x:Name="PnlDevice" Margin="4,8,0,0" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Tr Dev.Name}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ui:TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtAlias" ClearButtonEnabled="False" ToolTip="{l:Tr Dev.NameTip}"
                                            LostKeyboardFocus="TxtAlias_LostKeyboardFocus" KeyDown="TxtAlias_KeyDown" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{l:Tr Dev.OnConnect}" VerticalAlignment="Center" Margin="14,0,10,0" />
                                <ComboBox Grid.Row="0" Grid.Column="3" x:Name="CmbAction" Width="180" SelectionChanged="CmbAction_SelectionChanged">
                                    <ComboBoxItem Content="{l:Tr Dev.Action.Full}" ToolTip="{l:Tr Dev.Action.FullTip}" />
                                    <ComboBoxItem Content="{l:Tr Dev.Action.TvOnly}" ToolTip="{l:Tr Dev.Action.TvOnlyTip}" />
                                </ComboBox>
                                <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
                                    <ToggleButton x:Name="ChkRestoreOnDisconnect" Style="{StaticResource Toggle}" Margin="0,0,10,0"
                                                  Checked="ChkRestoreOnDisconnect_Changed" Unchecked="ChkRestoreOnDisconnect_Changed" ToolTip="{l:Tr Dev.RestoreTip}" />
                                    <TextBlock x:Name="LblRestore" VerticalAlignment="Center" TextWrapping="Wrap" ToolTip="{l:Tr Dev.RestoreTip}" />
                                </DockPanel>
                                <Button Grid.Row="1" Grid.Column="3" x:Name="BtnRemove" Style="{StaticResource QuietButton}" Content="{l:Tr Dev.Remove}"
                                        Margin="0,10,0,0" HorizontalAlignment="Right" Click="BtnRemove_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <DockPanel Margin="2,8,0,8">
                        <ComboBox DockPanel.Dock="Right" x:Name="CmbCategory" MinWidth="180" SelectionChanged="CmbCategory_SelectionChanged" />
                        <TextBlock Text="{l:Tr Dev.OnPc}" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DataGrid x:Name="GridConnected" Height="190" Style="{StaticResource DeviceGrid}"
                                      MouseDoubleClick="GridConnected_MouseDoubleClick">
                                <DataGrid.RowStyle>
                                    <!-- Must extend WPF-UI's row style, not the stock one, or rows render white. -->
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource DefaultDataGridRowStyle}">
                                        <Setter Property="ToolTip" Value="{Binding Detail}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWatched}" Value="True">
                                                <Setter Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:Tr Dev.Col.Device}" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="{l:Tr Dev.Col.Category}" Binding="{Binding CategoryText}" SortMemberPath="CategoryRank" Width="176" />
                                    <DataGridTextColumn Header="{l:Tr Dev.Col.Bus}" Binding="{Binding Bus}" Width="90" />
                                    <DataGridTemplateColumn Header="{l:Tr Dev.Col.Status}" SortMemberPath="IsConnected" Width="124">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DockPanel Margin="4,10,0,0">
                                <Button DockPanel.Dock="Right" x:Name="BtnAdd" Style="{StaticResource QuietButton}" Margin="8,0,0,0" Click="BtnAdd_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="14" Margin="0,0,6,0" />
                                        <TextBlock Text="{l:Tr Dev.Add}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="{l:Tr Dev.OnPc.Hint}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================== Settings ============================== -->
            <Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,24">
                    <TextBlock Text="せ っ て い" Style="{StaticResource Kana}" />
                    <TextBlock Text="{l:Tr Nav.Settings}" Style="{StaticResource PageTitle}" Margin="0,0,0,14" />

                    <!-- Automatic setup -->
                    <Border Style="{StaticResource SettingRow}" Background="{StaticResource HighlightRowBrush}" BorderBrush="#3A2F5E">
                        <StackPanel>
                            <DockPanel>
                                <Border Style="{StaticResource IconTile}" Background="#2A2147" TextElement.Foreground="{StaticResource SakuraBrush}">
                                    <ui:SymbolIcon Symbol="Wand24" Style="{StaticResource TileIcon}" />
                                </Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnFindTv" Style="{StaticResource QuietButton}" Content="{l:Tr Set.FindTv}" Click="FindTv_Click" />
                                    <Button x:Name="BtnAutoSetup" Style="{StaticResource PlayButton}" FontSize="13" Padding="16,8" Margin="8,0,0,0"
                                            Content="{l:Tr Home.Setup}" Click="AutoSetup_Click" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:Tr Set.Setup}" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="{l:Tr Set.Setup.Sub}" Style="{StaticResource Hint}" />
                                </StackPanel>
                            </DockPanel>
                            <ComboBox x:Name="CmbFoundTvs" Margin="46,10,0,0" HorizontalAlignment="Left" MinWidth="260" Visibility="Collapsed"
                                      SelectionChanged="CmbFoundTvs_SelectionChanged" />
                            <TextBlock x:Name="LblSetup" Style="{StaticResource Hint}" Margin="46,8,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!-- TV -->
                    <TextBlock Text="{l:Tr Set.Tv}" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}" TextElement.Foreground="{StaticResource SkyBrush}"><ui:SymbolIcon Symbol="Tv24" Style="{StaticResource TileIcon}" /></Border>
                            <ui:TextBox DockPanel.Dock="Right" x:Name="TxtIp" Width="200" PlaceholderText="192.168.1.50" ClearButtonEnabled="False" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{l:Tr Set.Address}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="LblAdb" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="PlugConnected24" Style="{StaticResource TileIcon}" /></Border>
                            <ComboBox DockPanel.Dock="Right" x:Name="CmbHdmi" Width="200" VerticalAlignment="Center">
                                <ComboBoxItem Content="HDMI 1" Tag="1" />
                                <ComboBoxItem Content="HDMI 2" Tag="2" />
                                <ComboBoxItem Content="HDMI 3" Tag="3" />
                                <ComboBoxItem Content="HDMI 4" Tag="4" />
                            </ComboBox>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.Hdmi}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.Hdmi.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Power24" Style="{StaticResource TileIcon}" /></Border>
                            <ToggleButton DockPanel.Dock="Right" x:Name="ChkWakeTV" Style="{StaticResource Toggle}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.Wake}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.Wake.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="DesktopFlow24" Style="{StaticResource TileIcon}" /></Border>
                            <ToggleButton DockPanel.Dock="Right" x:Name="ChkSourceSwitch" Style="{StaticResource Toggle}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.Switch}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.Switch.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="ArrowSync24" Style="{StaticResource TileIcon}" /></Border>
                            <ToggleButton DockPanel.Dock="Right" x:Name="ChkRestoreTvApp" Style="{StaticResource Toggle}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.ReturnApp}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.ReturnApp.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="WeatherMoon24" Style="{StaticResource TileIcon}" /></Border>
                            <ToggleButton DockPanel.Dock="Right" x:Name="ChkSleepTv" Style="{StaticResource Toggle}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.SleepTv}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.SleepTv.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Picture and sound -->
                    <TextBlock Text="{l:Tr Set.Picture}" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Desktop24" Style="{StaticResource TileIcon}" /></Border>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="CmbDisplay" Width="200" DropDownOpened="CmbDisplay_DropDownOpened" />
                                <Button x:Name="BtnDetectDisplay" Style="{StaticResource QuietButton}" Padding="10,8" Margin="8,0,0,0"
                                        Click="DetectDisplay_Click" ToolTip="{l:Tr Set.Display.Detect}">
                                    <ui:SymbolIcon Symbol="Search24" FontSize="16" />
                                </Button>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.Display}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.Display.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Apps24" Style="{StaticResource TileIcon}" /></Border>
                            <ToggleButton DockPanel.Dock="Right" x:Name="ChkDisableOthers" Style="{StaticResource Toggle}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.OnlyTv}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.OnlyTv.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Speaker224" Style="{StaticResource TileIcon}" /></Border>
                            <ToggleButton DockPanel.Dock="Right" x:Name="ChkSwitchAudio" Style="{StaticResource Toggle}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.Sound}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.Sound.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="BrightnessHigh24" Style="{StaticResource TileIcon}" /></Border>
                            <ToggleButton DockPanel.Dock="Right" x:Name="ChkHdr" Style="{StaticResource Toggle}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.Hdr}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.Hdr.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Steam -->
                    <TextBlock Text="{l:Tr Set.Steam}" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}" TextElement.Foreground="{StaticResource SakuraBrush}"><ui:SymbolIcon Symbol="Games24" Style="{StaticResource TileIcon}" /></Border>
                            <ToggleButton DockPanel.Dock="Right" x:Name="ChkBigPicture" Style="{StaticResource Toggle}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.BigPicture}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.BigPicture.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="ArrowMinimize24" Style="{StaticResource TileIcon}" /></Border>
                            <ToggleButton DockPanel.Dock="Right" x:Name="ChkMinimizeSteam" Style="{StaticResource Toggle}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.MinimizeSteam}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.MinimizeSteam.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Timer24" Style="{StaticResource TileIcon}" /></Border>
                            <ComboBox DockPanel.Dock="Right" x:Name="CmbGrace" Width="200" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.Grace}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.Grace.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" Background="Transparent" BorderBrush="{StaticResource LineBrush}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}" Background="Transparent" TextElement.Foreground="{StaticResource SakuraBrush}"><ui:SymbolIcon Symbol="Games24" Style="{StaticResource TileIcon}" /></Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="{l:Tr Set.PerDevice.Button}" Click="GoDevices_Click" />
                            <TextBlock Text="{l:Tr Set.PerDevice}" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" />
                        </DockPanel>
                    </Border>

                    <!-- App -->
                    <TextBlock Text="{l:Tr Set.App}" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Translate24" Style="{StaticResource TileIcon}" /></Border>
                            <ComboBox DockPanel.Dock="Right" x:Name="CmbLanguage" Width="200" VerticalAlignment="Center" SelectionChanged="CmbLanguage_SelectionChanged">
                                <ComboBoxItem Tag="" Content="{l:Tr Set.Language.System}" />
                                <ComboBoxItem Tag="en" Content="English" />
                                <ComboBoxItem Tag="ru" Content="Русский" />
                            </ComboBox>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.Language}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.Language.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Power24" Style="{StaticResource TileIcon}" /></Border>
                            <ToggleButton DockPanel.Dock="Right" x:Name="ChkAutostart" Style="{StaticResource Toggle}"
                                          Checked="ChkAutostart_CheckedChanged" Unchecked="ChkAutostart_CheckedChanged" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.Autostart}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.Autostart.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Pulse24" Style="{StaticResource TileIcon}" /></Border>
                            <ToggleButton DockPanel.Dock="Right" x:Name="ChkAutoMonitor" Style="{StaticResource Toggle}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.AutoMonitor}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.AutoMonitor.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}" TextElement.Foreground="{StaticResource SakuraBrush}"><ui:SymbolIcon Symbol="WeatherMoon24" Style="{StaticResource TileIcon}" /></Border>
                            <ToggleButton DockPanel.Dock="Right" x:Name="ChkAnimate" Style="{StaticResource Toggle}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.Animate}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.Animate.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}" VerticalAlignment="Top"><ui:SymbolIcon Symbol="Keyboard24" Style="{StaticResource TileIcon}" /></Border>
                            <Grid DockPanel.Dock="Right" Margin="16,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" x:Name="LblHotkeyOn" Text="{l:Tr Set.Hotkeys.On}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource SoftBrush}" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtActivateHotkey" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown"
                                         GotKeyboardFocus="Hotkey_GotKeyboardFocus" LostKeyboardFocus="Hotkey_LostKeyboardFocus" />
                                <TextBlock Grid.Row="1" x:Name="LblHotkeyOff" Text="{l:Tr Set.Hotkeys.Off}" VerticalAlignment="Center" Margin="0,6,10,0" Foreground="{StaticResource SoftBrush}" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtDeactivateHotkey" IsReadOnly="True" PreviewKeyDown="Hotkey_PreviewKeyDown" Margin="0,6,0,0"
                                         GotKeyboardFocus="Hotkey_GotKeyboardFocus" LostKeyboardFocus="Hotkey_LostKeyboardFocus" />
                                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource QuietButton}" Content="{l:Tr Set.Hotkeys.Save}" Click="SaveHotkeys_Click" Margin="0,6,0,0" />
                            </Grid>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.Hotkeys}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.Hotkeys.Sub}" Style="{StaticResource Hint}" />
                                <DockPanel Margin="0,10,0,0">
                                    <ToggleButton x:Name="ChkHotkeyToggle" Style="{StaticResource Toggle}" Margin="0,0,10,0"
                                                  Checked="ChkHotkeyToggle_Changed" Unchecked="ChkHotkeyToggle_Changed" />
                                    <TextBlock Text="{l:Tr Set.Hotkeys.Toggle}" Style="{StaticResource Hint}" FontSize="13" Foreground="{StaticResource SoftBrush}" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock x:Name="LblHotkeys" Style="{StaticResource Hint}" Foreground="{StaticResource AmberBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- About -->
                    <TextBlock Text="{l:Tr Set.About}" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Info24" Style="{StaticResource TileIcon}" /></Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="{l:Tr Set.GitHub}" Click="GitHub_Click" Margin="8,0,0,0" />
                            <Button DockPanel.Dock="Right" x:Name="BtnCheckUpdates" Style="{StaticResource QuietButton}" Content="{l:Tr Set.CheckUpdates}" Click="CheckUpdates_Click" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock x:Name="LblVersion" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.Version.Sub}" Style="{StaticResource Hint}" />
                                <TextBlock x:Name="LblUpdateStatus" Style="{StaticResource Hint}" Foreground="{StaticResource MintBrush}" Visibility="Collapsed" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border x:Name="RowSupport" Style="{StaticResource SettingRow}" Visibility="Collapsed">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}" TextElement.Foreground="{StaticResource SakuraBrush}"><ui:SymbolIcon Symbol="Heart24" Style="{StaticResource TileIcon}" /></Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="{l:Tr Set.Support.Button}" Click="Support_Click" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Set.Support}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.Support.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Rarely needed -->
                    <Expander Margin="0,18,0,0" Foreground="{StaticResource TextBrush}">
                        <Expander.Header>
                            <StackPanel Margin="4,2">
                                <TextBlock Text="{l:Tr Set.Advanced}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Set.Advanced.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Expander.Header>
                        <Border Style="{StaticResource CardBorder}" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:Tr Set.Launcher}" Margin="0,0,0,6" Foreground="{StaticResource SoftBrush}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" x:Name="BtnDetectLauncher" Style="{StaticResource QuietButton}" Content="{l:Tr Set.Find}" Margin="8,0,0,0" Click="DetectLauncher_Click" />
                                    <ui:TextBox x:Name="TxtTvHomeComponent" FontFamily="Consolas" FontSize="12" PlaceholderText="{l:Tr Set.Launcher.Placeholder}" ClearButtonEnabled="False" />
                                </DockPanel>
                                <TextBlock x:Name="LblTvSetup" Style="{StaticResource Hint}" Margin="0,4,0,0" />

                                <TextBlock Text="{l:Tr Set.AudioDevice}" Margin="0,14,0,6" Foreground="{StaticResource SoftBrush}" />
                                <ui:TextBox x:Name="TxtTvAudioDevice" PlaceholderText="{l:Tr Set.AudioDevice.Placeholder}" ClearButtonEnabled="False" />

                                <TextBlock Text="steam.exe" Margin="0,14,0,6" Foreground="{StaticResource SoftBrush}" />
                                <ui:TextBox x:Name="TxtSteamPath" ClearButtonEnabled="False" />

                                <TextBlock Text="adb.exe" Margin="0,14,0,6" Foreground="{StaticResource SoftBrush}" />
                                <ui:TextBox x:Name="TxtAdbPath" ClearButtonEnabled="False" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{l:Tr Set.AdbHint}" />
                            </StackPanel>
                        </Border>
                    </Expander>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================== Home Assistant ============================== -->
            <Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,24">
                    <TextBlock Text="ホ ー ム ア シ ス タ ン ト" Style="{StaticResource Kana}" />
                    <TextBlock Text="{l:Tr Nav.HomeAssistant}" Style="{StaticResource PageTitle}" Margin="0,0,0,14" />

                    <TextBlock Text="{l:Tr Ha.Broker}" Style="{StaticResource Section}" Margin="2,0,0,8" />
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Building24" Style="{StaticResource TileIcon}" /></Border>
                            <ToggleButton DockPanel.Dock="Right" x:Name="ChkMqttEnabled" Style="{StaticResource Toggle}"
                                          Checked="ChkMqttEnabled_Changed" Unchecked="ChkMqttEnabled_Changed" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Ha.Enable}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{l:Tr Ha.Enable.Sub}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{l:Tr Ha.Host}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource SoftBrush}" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtMqttHost" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{l:Tr Ha.Port}" VerticalAlignment="Center" Margin="14,0,10,0" Foreground="{StaticResource SoftBrush}" />
                                <ui:NumberBox Grid.Row="0" Grid.Column="3" x:Name="NumMqttPort" Minimum="1" Maximum="65535"
                                              SpinButtonPlacementMode="Hidden" ClearButtonEnabled="False" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{l:Tr Ha.Login}" VerticalAlignment="Center" Margin="0,8,10,0" Foreground="{StaticResource SoftBrush}" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtMqttUser" Margin="0,8,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{l:Tr Ha.Password}" VerticalAlignment="Center" Margin="14,8,10,0" Foreground="{StaticResource SoftBrush}" />
                                <PasswordBox Grid.Row="1" Grid.Column="3" x:Name="PwdMqtt" Margin="0,8,0,0" />
                            </Grid>
                            <DockPanel Margin="0,12,0,0">
                                <Button x:Name="BtnMqttApply" Style="{StaticResource QuietButton}" Content="{l:Tr Ha.Apply}" Click="BtnMqttApply_Click" />
                                <Button x:Name="BtnMqttTest" Style="{StaticResource QuietButton}" Content="{l:Tr Ha.Test}" Margin="8,0,0,0" Click="BtnMqttTest_Click" />
                                <TextBlock x:Name="LblMqttStatus" Margin="14,0,0,0" FontWeight="Medium" Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{l:Tr Ha.Power}" Style="{StaticResource Section}" />
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Power24" Style="{StaticResource TileIcon}" /></Border>
                            <ToggleButton DockPanel.Dock="Right" x:Name="ChkMqttPower" Style="{StaticResource Toggle}"
                                          Checked="ChkMqttPower_Changed" Unchecked="ChkMqttPower_Changed" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                <TextBlock Text="{l:Tr Ha.PowerEnable}" Style="{StaticResource RowTitle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="LblMqttPowerInfo" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="{l:Tr Ha.Wol}" TextWrapping="Wrap" Foreground="{StaticResource SoftBrush}" Margin="0,0,0,8" />
                            <TextBox x:Name="TxtPcMac" IsReadOnly="True" FontFamily="Consolas" HorizontalAlignment="Left" MinWidth="200" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ============================== Diagnostics ============================== -->
            <Border>
                <DockPanel Margin="24,20,24,20">
                    <TextBlock DockPanel.Dock="Top" Text="し ん だ ん" Style="{StaticResource Kana}" />
                    <TextBlock DockPanel.Dock="Top" Text="{l:Tr Nav.Diagnostics}" Style="{StaticResource PageTitle}" Margin="0,0,0,10" />
                    <TextBlock DockPanel.Dock="Top" Text="{l:Tr Diag.Steps}" Style="{StaticResource Section}" Margin="2,4,0,2" />
                    <TextBlock DockPanel.Dock="Top" Text="{l:Tr Diag.Steps.Sub}" Style="{StaticResource Hint}" Margin="2,0,0,8" />
                    <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}" Padding="10">
                        <UniformGrid x:Name="TestButtonsPanel" Columns="3">
                            <UniformGrid.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                                    <Setter Property="Margin" Value="4" />
                                    <Setter Property="Padding" Value="10,8" />
                                </Style>
                            </UniformGrid.Resources>
                        </UniformGrid>
                    </Border>
                    <DockPanel DockPanel.Dock="Top" Margin="2,18,0,8">
                        <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="{l:Tr Diag.OpenLog}" Click="OpenLogFile_Click" />
                        <TextBlock Text="{l:Tr Diag.Log}" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Style="{StaticResource CardBorder}" Padding="2">
                        <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="NoWrap" MinHeight="140" BorderThickness="0" Background="Transparent"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="12" Foreground="{StaticResource SoftBrush}" />
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
