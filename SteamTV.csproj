<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>SteamTV</RootNamespace>
    <AssemblyName>SteamTV</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
    <ApplicationIcon>start_icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
  </ItemGroup>

  <!--
    Only needed so that `dotnet build` can build net4.8 on a machine without the
    Targeting Pack installed (this is a build-time Microsoft package, not included in the exe).
    If .NET Framework 4.8 Developer Pack is already on the system — this line can be removed.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <!--
    Merges WPF-UI.dll (and any other dependency) into SteamTV.exe at build time, so the
    Release output is a single file to hand out — no more shipping a DLL alongside the exe.
  -->
  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="6.2.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Exclude Displaytest.cs from the main project (it has its own Main entry point) -->
  <ItemGroup>
    <Compile Remove="Displaytest.cs" />
  </ItemGroup>

</Project>
