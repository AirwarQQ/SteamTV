<!-- NekoCouch look: a calm night palette (deep indigo, sakura pink, lavender, sky blue) on top of
     WPF-UI's dark theme. The WPF-UI brush keys overridden at the bottom make its stock controls
     (text boxes, combo boxes, data grids, expanders) pick up the same palette. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:c="clr-namespace:NekoCouch.Controls">

    <!-- Palette -->
    <Color x:Key="DeepColor">#0A0C18</Color>
    <Color x:Key="BgColor">#0F1222</Color>
    <Color x:Key="CardColor">#161A2E</Color>
    <Color x:Key="CardHoverColor">#1C2139</Color>
    <Color x:Key="FieldColor">#12152A</Color>
    <Color x:Key="LineColor">#262B47</Color>
    <Color x:Key="LineStrongColor">#353B5E</Color>
    <Color x:Key="TextColor">#ECEBF5</Color>
    <Color x:Key="SoftColor">#C4C6DC</Color>
    <Color x:Key="MutedColor">#8E93B4</Color>
    <Color x:Key="SakuraColor">#FF7EB6</Color>
    <Color x:Key="LavenderColor">#9B8CFF</Color>
    <Color x:Key="SkyColor">#7FD6FF</Color>
    <Color x:Key="MintColor">#7EE8C4</Color>
    <Color x:Key="AmberColor">#FFC978</Color>
    <Color x:Key="RoseColor">#FF8A8A</Color>

    <SolidColorBrush x:Key="DeepBrush" Color="{StaticResource DeepColor}" />
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SoftBrush" Color="{StaticResource SoftColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="SakuraBrush" Color="{StaticResource SakuraColor}" />
    <SolidColorBrush x:Key="LavenderBrush" Color="{StaticResource LavenderColor}" />
    <SolidColorBrush x:Key="SkyBrush" Color="{StaticResource SkyColor}" />
    <SolidColorBrush x:Key="MintBrush" Color="{StaticResource MintColor}" />
    <SolidColorBrush x:Key="AmberBrush" Color="{StaticResource AmberColor}" />
    <SolidColorBrush x:Key="RoseBrush" Color="{StaticResource RoseColor}" />
    <SolidColorBrush x:Key="IconTileBrush" Color="#1F2442" />
    <SolidColorBrush x:Key="ChipBrush" Color="#20264A" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#1A1E36" />

    <LinearGradientBrush x:Key="SakuraGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF7EB6" Offset="0" />
        <GradientStop Color="#9B8CFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SakuraDiagonal" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF7EB6" Offset="0" />
        <GradientStop Color="#9B8CFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PlayGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF8CC0" Offset="0" />
        <GradientStop Color="#E05A98" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PlayHoverGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF9DCB" Offset="0" />
        <GradientStop Color="#EB68A5" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PlayPressedGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E86BA6" Offset="0" />
        <GradientStop Color="#C94C86" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HighlightRowBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#1D1838" Offset="0" />
        <GradientStop Color="#161A2E" Offset="1" />
    </LinearGradientBrush>

    <!-- Fonts: rounded M+ (subset: Latin, Cyrillic and kana, see Fonts/OFL.txt) for headings.
         The small kana labels are deliberately light: the UI font, with kana from the Japanese
         UI font every Windows has. -->
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Fonts/#Rounded Mplus 1c</FontFamily>
    <FontFamily x:Key="SectionFont">pack://application:,,,/Fonts/#Rounded Mplus 1c Bold</FontFamily>
    <FontFamily x:Key="BodyFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Small headings: the rounded font has no hinting once subset and looks rough at 13–14 px. -->
    <FontFamily x:Key="HeadingFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="KanaFont">Segoe UI Variable Text, Segoe UI, Yu Gothic UI</FontFamily>

    <!-- Text -->
    <Style x:Key="Kana" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource KanaFont}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SakuraBrush}" />
        <Setter Property="Opacity" Value="0.9" />
    </Style>
    <Style x:Key="PageTitle" TargetType="c:SmoothText">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource SakuraBrush}" />
        <Setter Property="Margin" Value="2,18,0,8" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource HeadingFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="RowTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style x:Key="SettingRow" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{StaticResource IconTileBrush}" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource LavenderBrush}" />
    </Style>
    <Style x:Key="TileIcon" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Chip" TargetType="Border">
        <!-- Exactly half the height: WPF draws a radius bigger than that as a pointed "lens". -->
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="MinHeight" Value="19" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="Background" Value="{StaticResource ChipBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontSize" Value="11" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource SoftBrush}" />
    </Style>

    <!-- Toggle: pill track that fills with the sakura gradient, knob slides over. -->
    <Style x:Key="Toggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" CornerRadius="11" Background="#2A2F4F" />
                        <Border x:Name="TrackOn" CornerRadius="11" Background="{StaticResource SakuraGradient}" Opacity="0" />
                        <Ellipse x:Name="Knob" Width="14" Height="14" HorizontalAlignment="Left" Margin="4,0,0,0" Fill="{StaticResource MutedBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Margin" To="22,0,0,0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ThicknessAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="Margin" To="4,0,0,0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="Knob" Property="Fill" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#343A60" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The one big call to action. -->
    <Style x:Key="PlayButton" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="24,11" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="12" Background="{StaticResource PlayGradient}" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect x:Name="Glow" Color="#FF7EB6" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.35" />
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PlayHoverGradient}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PlayPressedGradient}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Everything else: quiet card-coloured buttons. -->
    <Style x:Key="QuietButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="16,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineStrongBrush}"
                            BorderThickness="1" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardHoverBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5A5F8F" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource FieldBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LavenderBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar entries: a soft highlight with a sakura bar on the selected one. -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource SoftBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent" Padding="12,9">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Bar" Width="3" CornerRadius="2" Margin="0,9" HorizontalAlignment="Left"
                                Background="{StaticResource SakuraBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#141832" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavSelectedBrush}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tooltips: a small card in the palette. Display text formatting keeps the small text crisp
         in the popup window (which renders without ClearType). -->
    <Style TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="#1E2340" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="10"
                            Padding="12,9" MaxWidth="340" Margin="0,4">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="LineHeight" Value="18" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WPF-UI's own brushes, re-pointed at the palette so its controls blend in. -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource SoftColor}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="TextPlaceholderColorBrush" Color="#6E7396" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource FieldColor}" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#191D35" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#10132A" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="#0C0F22" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#141729" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="TextControlFocusedBorderBrush" Color="{StaticResource SakuraColor}" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="#20264A" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#1A1E36" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#151830" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="ExpanderHeaderBorderBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="ExpanderHeaderBorderPointerOverBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="ListViewItemPillFillBrush" Color="{StaticResource SakuraColor}" />
    <SolidColorBrush x:Key="ComboBoxItemPillFillBrush" Color="{StaticResource SakuraColor}" />
</ResourceDictionary>
